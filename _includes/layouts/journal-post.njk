<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{#- Page and share metadata come from the entry itself: its title, its
    Excerpt (summary), and its Featured Image, falling back to the site
    share image when an entry has none. -#}
{%- set metaTitle = (title | trim) + " | Sarahtonin Sounds" %}
{%- set metaDescription = (excerpt or reflection or "") | trim %}
{#- Monthly Favs posts (layouts/monthly-favs.njk) render through this
    same layout with their own title block and content in place of the
    essay's. -#}
{%- set isMonthlyFav = category == "Monthly Favs" %}
{%- if featured_image %}
{%- set shareImage = featured_image if (featured_image.indexOf("http") == 0) else "https://sarahtoninsounds.com" + featured_image %}
{%- else %}
{%- set shareImage = "https://sarahtoninsounds.com/assets/images/brand/share-image.jpg" %}
{%- endif %}
<title>{{ metaTitle }}</title>
<meta name="description" content="{{ metaDescription }}">
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/images/brand/favicon-32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/assets/images/brand/favicon-16.png">
<link rel="icon" type="image/png" sizes="192x192" href="/assets/images/brand/icon-192.png">
<link rel="icon" type="image/png" sizes="512x512" href="/assets/images/brand/icon-512.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta property="og:type" content="article">
<meta property="og:site_name" content="Sarahtonin Sounds">
<meta property="og:title" content="{{ metaTitle }}">
<meta property="og:description" content="{{ metaDescription }}">
<meta property="og:url" content="https://sarahtoninsounds.com{{ page.url }}">
<meta property="og:image" content="{{ shareImage }}">
{%- if not featured_image %}
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Sarahtonin Sounds">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ metaTitle }}">
<meta name="twitter:description" content="{{ metaDescription }}">
<meta name="twitter:image" content="{{ shareImage }}">
{%- if not featured_image %}
<meta name="twitter:image:alt" content="Sarahtonin Sounds">
{%- endif %}
<!-- All fonts are self-hosted via css/tokens.css's @font-face rules;
     no Google Fonts requests. See assets/fonts/README.md. -->
<link rel="stylesheet" href="/css/tokens.css">
<link rel="stylesheet" href="/css/base.css">
<link rel="stylesheet" href="/css/layout.css">
<link rel="stylesheet" href="/css/journal-post.css">
{%- if isMonthlyFav %}
<link rel="stylesheet" href="/css/playlist.css">
<link rel="stylesheet" href="/css/monthly-favs.css">
{%- endif %}
</head>
<body class="page-journal-post">
<a class="skip-link" href="#main">Skip to content</a>

<main id="main" class="journal-post-page">
  <div class="jp-page">

    <!-- Desktop — this file is the Eleventy layout every Journal essay
         renders through (content/journal/essays/*.md, tags:
         journalEssay). Everything below is unchanged, hand-verified
         markup/CSS from the standalone build (see TODO.md, "Journal
         Post Desktop — Full rebuild from new Figma reference") — per
         explicit instruction, this conversion only swaps static text
         and images for the essay's own title/category/date/body fields,
         and wraps each already-documented "CMS: optional" block in a
         conditional bound to a field no current essay sets yet, so it
         stays absent exactly as it does today rather than being
         deleted. No positioning, CSS, or markup structure was touched. -->

    <div class="jp-header">
      <div class="jp-header__decor" aria-hidden="true">
        <div class="jp-header__stripe"></div>
        <div class="jp-logo-badge">
          <a class="jp-logo-badge__inner logo-home-link" href="/" data-card-inset="0.057 0.0749 0.0665 0.0672" aria-label="Sarahtonin Sounds, go to Home">
            <img src="/assets/images/home-v2/home-logo-sharp.png" alt="">
          </a>
        </div>
      </div>

      <nav class="jp-nav" aria-label="Primary">
        <ul>
          <li><a href="/" class="jp-nav__tab">Home</a></li>
          <li><a href="/about.html" class="jp-nav__tab">About</a></li>
          <li><a href="/listen.html" class="jp-nav__tab">Listen</a></li>
          <li><a href="/journal.html" class="jp-nav__tab" aria-current="page">Journal</a></li>
          <li><a href="/contact.html" class="jp-nav__tab">Contact</a></li>
        </ul>
      </nav>
    </div>

    {%- if isMonthlyFav %}
    <div class="mf-page">{{ content | safe }}</div>
    {%- else %}
    <div class="jp-title-block">
      <p class="jp-title-block__meta">{{ category }} &middot; {{ (postDate or date) | journalDate }}</p>
      <div class="jp-title-block__meta-rule" aria-hidden="true"></div>
      <h1 class="jp-title-block__title">{{ title }}</h1>
      <div class="jp-title-block__rule" aria-hidden="true"></div>
    </div>

    <div class="jp-article">

      <!-- CMS: optional — renders only once the entry's Hero Image is
           set (admin/config.yml). Absent otherwise, the "body-only" case. -->
      {% if hero and hero.image %}
      <figure class="jp-hero">
        <img class="jp-hero__photo jp-photo--{{ hero.position or 'center' }}" src="{{ hero.image }}" alt="{{ hero.alt }}">
        {% if hero.caption %}<figcaption class="jp-hero__caption">{{ hero.caption }}</figcaption>{% endif %}
      </figure>
      {% endif %}

      <!-- CMS: required — the essay's full markdown body. -->
      <div class="jp-body-copy">{{ content | safe }}</div>

      <!-- CMS: optional — same as hero, absent until its image is set. -->
      {% if polaroid1 and polaroid1.image %}
      <figure class="jp-polaroid jp-polaroid--1">
        <div class="jp-polaroid__card">
          <img class="jp-polaroid__tape" src="/assets/images/journal/tape-orange.png" alt="">
          <img class="jp-polaroid__photo" src="{{ polaroid1.image }}" alt="{{ polaroid1.alt }}">
          {% if polaroid1.caption %}<figcaption class="jp-polaroid__caption">{{ polaroid1.caption }}</figcaption>{% endif %}
          <img class="jp-decor__star jp-decor__star--1" src="/assets/images/shared/doodles/star-scribble.png" alt="">
        </div>
      </figure>
      {% endif %}

      {% if body2 %}
      <div class="jp-body-copy">{{ body2 | safe }}</div>
      {% endif %}

      {% if pullQuote %}
      <blockquote class="jp-pull-quote">
        <span class="jp-pull-quote__mark jp-pull-quote__mark--open" aria-hidden="true">&ldquo;</span>
        <p class="jp-pull-quote__text">{{ pullQuote.text }}</p>
        <span class="jp-pull-quote__mark jp-pull-quote__mark--close" aria-hidden="true">&rdquo;</span>
        <img class="jp-decor__megaphone" src="/assets/images/journal/megaphone.png" alt="" aria-hidden="true">
      </blockquote>
      {% endif %}

      {% if body3 %}
      <div class="jp-body-copy">{{ body3 | safe }}</div>
      {% endif %}

      {% if polaroid2 and polaroid2.image %}
      <figure class="jp-polaroid jp-polaroid--2">
        <div class="jp-polaroid__card">
          <img class="jp-polaroid__tape" src="/assets/images/journal/tape-orange.png" alt="">
          <img class="jp-polaroid__photo" src="{{ polaroid2.image }}" alt="{{ polaroid2.alt }}">
          {% if polaroid2.caption %}<figcaption class="jp-polaroid__caption">{{ polaroid2.caption }}</figcaption>{% endif %}
          <img class="jp-decor__star jp-decor__star--2" src="/assets/images/shared/doodles/star-scribble.png" alt="">
        </div>
      </figure>
      {% endif %}

      {% if body4 %}
      <div class="jp-body-copy">{{ body4 | safe }}</div>
      {% endif %}

    </div>
    {%- endif %}
  </div>

  <!-- Mobile Journal Post (Header/Nav/Title Block/Polaroid Hero built;
       Essay Body wired to the same rendered body as desktop, matching
       this section's own "essay.body" marker convention. The polaroid
       hero shows the entry's Hero Image, falling back to its Featured
       Image, and is left out when neither is set. The
       scribble-star divider that sat mid-placeholder is omitted: it has
       no CMS field deciding whether/where it appears, per this section's
       own "a real essay's CMS content decides... where" note. -->
  <div class="jpm-page" id="journal-post-mobile-stage">
    <header class="jpm-header">
      <div class="jpm-header__logo">
        <a class="jpm-header__logo-inner logo-home-link" href="/" data-card-inset="0.057 0.0749 0.0665 0.0672" aria-label="Sarahtonin Sounds, go to Home">
          <img src="/assets/images/home-v2/home-logo-sharp.png" alt="">
        </a>
      </div>
    </header>

    <nav class="jpm-nav" aria-label="Primary">
      <ul class="jpm-nav__list">
        <li class="jpm-nav__item jpm-nav__item--home"><a href="/" class="jpm-nav__tab">Home</a></li>
        <li class="jpm-nav__item jpm-nav__item--about"><a href="/about.html" class="jpm-nav__tab">About</a></li>
        <li class="jpm-nav__item jpm-nav__item--listen"><a href="/listen.html" class="jpm-nav__tab">Listen</a></li>
        <li class="jpm-nav__item jpm-nav__item--journal"><a href="/journal.html" class="jpm-nav__tab" aria-current="page">Journal</a></li>
        <li class="jpm-nav__item jpm-nav__item--contact"><a href="/contact.html" class="jpm-nav__tab">Contact</a></li>
      </ul>
    </nav>

    {%- if isMonthlyFav %}
    <div class="mf-page mf-page--mobile">{{ content | safe }}</div>
    {%- else %}
    <div class="jpm-title-block">
      <p class="jpm-title-block__meta">{{ category }} &middot; {{ (postDate or date) | journalDate }}</p>
      <h1 class="jpm-title-block__title">{{ title }}</h1>
      <div class="jpm-title-block__rule" aria-hidden="true"></div>
    </div>

    {%- set mobileHeroImage = (hero and hero.image) or featured_image %}
    {%- set mobileHeroPosition = (hero.position if (hero and hero.image and hero.position) else 'center') %}
    {% if mobileHeroImage %}
    <div class="jpm-polaroid-hero">
      <div class="jpm-polaroid">
        <div class="jpm-polaroid__frame">
          <img class="jpm-polaroid__photo jp-photo--{{ mobileHeroPosition }}" src="{{ mobileHeroImage }}" alt="{{ hero.alt if (hero and hero.image) else '' }}">
        </div>
        <img class="jpm-polaroid__tape" src="/assets/images/journal/tape-orange.png" alt="">
      </div>
    </div>
    {% endif %}

    <div class="jpm-body-copy">{{ content | safe }}</div>
    {%- endif %}

    <div class="jpm-collage-footer" aria-hidden="true"></div>

    {% include "site-footer.njk" %}
  </div>
</main>

{% include "site-footer.njk" %}

<script src="/js/site.js" defer></script>
{%- if isMonthlyFav and (spotify_url | spotifyEmbedUrl) and (apple_music_url | appleEmbedUrl) %}
<script src="/js/playlist-player.js" defer></script>
{%- endif %}
</body>
</html>
