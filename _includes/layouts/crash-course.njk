<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{#- Every live Crash Course renders through this layout
    (content/listen/crash-courses/*.md, tag crashCourse). The Intro field
    is the entry's Markdown body, so it arrives here as `content`. -#}
{%- set metaTitle = (title | trim) + " | Sarahtonin Sounds" %}
{%- set shareImage = card_art if ((card_art or "").indexOf("http") == 0) else "https://sarahtoninsounds.com" + card_art %}
{%- set spotifySrc = spotify_url | spotifyEmbedUrl %}
{%- set appleSrc = apple_music_url | appleEmbedUrl %}
{%- set artSrcset = card_art | imageSrcset([400, 600, 800, 1200]) %}
{%- set others = collections.crashCourseLive | otherCrashCourses(page.url, 3) %}
<title>{{ metaTitle }}</title>
{%- if hook %}
<meta name="description" content="{{ hook | trim }}">
{%- endif %}
{% include "partials/crash-course-head.njk" %}
<meta property="og:type" content="article">
<meta property="og:title" content="{{ metaTitle }}">
{%- if hook %}
<meta property="og:description" content="{{ hook | trim }}">
{%- endif %}
<meta property="og:url" content="https://sarahtoninsounds.com{{ page.url }}">
<meta property="og:image" content="{{ shareImage }}">
<meta property="og:image:alt" content="{{ card_art_alt }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ metaTitle }}">
{%- if hook %}
<meta name="twitter:description" content="{{ hook | trim }}">
{%- endif %}
<meta name="twitter:image" content="{{ shareImage }}">
<meta name="twitter:image:alt" content="{{ card_art_alt }}">
</head>
<body class="page-listen page-crash-course">
<a class="skip-link" href="#main">Skip to content</a>

{% include "partials/crash-course-header.njk" %}

<main id="main" class="cc-page cc-course">
  <p class="cc-back"><a href="/listen.html"><span class="arrow-line cc-back__arrow" aria-hidden="true"></span>Back to Listen</a></p>

  <div class="cc-course__top">
    <div class="cc-course__art">
      <img class="cc-course__img" src="{{ card_art | imageSrc(800) }}"{% if artSrcset %} srcset="{{ artSrcset }}" sizes="(max-width: 760px) 80vw, 460px"{% endif %} alt="{{ card_art_alt }}" width="800" height="800" decoding="async">
      <img class="cc-course__tape" src="/assets/images/journal/tape-orange.png" alt="">
    </div>

    <div class="cc-course__main">
      <p class="cc-course__kicker">a crash course in</p>
      <h1 class="cc-course__title">{{ title }}</h1>
      {%- if content | trim %}
      <div class="cc-course__intro">
        {{ content | safe }}
      </div>
      {%- endif %}

      {%- if spotifySrc or appleSrc %}
      <div class="cc-player" data-cc-player>
        {%- if spotifySrc and appleSrc %}
        {#- Shown by js/crash-course.js; without it the page just plays Spotify. #}
        <div class="cc-player__source" role="group" aria-label="Listen on" hidden>
          <button type="button" class="cc-player__source-btn" data-source="spotify" aria-pressed="true">Spotify</button>
          <button type="button" class="cc-player__source-btn" data-source="apple" aria-pressed="false">Apple Music</button>
        </div>
        {%- endif %}
        {%- if spotifySrc %}
        <div class="cc-player__embed" data-source="spotify">
          <iframe src="{{ spotifySrc }}" title="Spotify player: {{ title }} playlist" height="352" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
        </div>
        {%- endif %}
        {%- if appleSrc %}
        {#- Built on demand by js/crash-course.js: removing an embed is the
            only way to stop it, so the hidden one is never left playing. #}
        <div class="cc-player__embed" data-source="apple" data-embed-src="{{ appleSrc }}" data-embed-title="Apple Music player: {{ title }} playlist"{% if spotifySrc %} hidden{% endif %}>
          {%- if not spotifySrc %}
          <iframe src="{{ appleSrc }}" title="Apple Music player: {{ title }} playlist" height="450" allow="autoplay *; encrypted-media *; fullscreen *; clipboard-write" sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-storage-access-by-user-activation allow-top-navigation-by-user-activation" loading="lazy"></iframe>
          {%- endif %}
        </div>
        {%- endif %}
      </div>
      {%- endif %}
    </div>
  </div>

  {%- if start_here.length or others.length %}
  <div class="cc-course__bottom">
    {%- if start_here.length %}
    <section class="cc-start" aria-labelledby="cc-start-heading">
      <h2 id="cc-start-heading" class="cc-section-heading">Start here</h2>
      <ol class="cc-start__list">
        {%- for item in start_here %}
        <li class="cc-start__item">
          <span class="cc-start__number" aria-hidden="true">{{ loop.index }}</span>
          <p class="cc-start__text">
            <span class="cc-start__track">{{ item.track }}</span>
            <span class="cc-start__artist">by {{ item.artist }}</span>
            {%- if item.note %}
            <span class="cc-start__note">{{ item.note }}</span>
            {%- endif %}
          </p>
        </li>
        {%- endfor %}
      </ol>
    </section>
    {%- endif %}

    {%- if others.length %}
    <section class="cc-more" aria-labelledby="cc-more-heading">
      <h2 id="cc-more-heading" class="cc-section-heading">More crash courses</h2>
      <ul class="cc-more__list">
        {%- set cardHeading = "h3" %}
        {%- set cardSizes = "(max-width: 760px) 45vw, 160px" %}
        {%- for course in others %}
        <li>{% include "partials/crash-course-card.njk" %}</li>
        {%- endfor %}
      </ul>
    </section>
    {%- endif %}
  </div>
  {%- endif %}
</main>

{% include "site-footer.njk" %}

<script src="/js/site.js" defer></script>

{%- if spotifySrc and appleSrc %}
<script src="/js/crash-course.js" defer></script>
{%- endif %}
</body>
</html>
