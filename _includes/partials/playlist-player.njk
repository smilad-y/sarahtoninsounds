{#- Spotify / Apple Music playlist player, shared by Crash Course pages
    and Monthly Favs posts. Expects spotifySrc and appleSrc (embed URLs
    from the spotifyEmbedUrl / appleEmbedUrl filters) and playerTitle
    (e.g. "An Intro to Arabic Music playlist"). The toggle only appears
    when both links exist; the page then also loads
    /js/playlist-player.js. -#}
{%- if spotifySrc or appleSrc %}
<div class="cc-player" data-cc-player>
  {%- if spotifySrc and appleSrc %}
  {#- Shown by js/playlist-player.js; without it the page just plays Spotify. #}
  <div class="cc-player__source" role="group" aria-label="Listen on" hidden>
    <button type="button" class="cc-player__source-btn" data-source="spotify" aria-pressed="true">Spotify</button>
    <button type="button" class="cc-player__source-btn" data-source="apple" aria-pressed="false">Apple Music</button>
  </div>
  {%- endif %}
  {%- if spotifySrc %}
  <div class="cc-player__embed" data-source="spotify">
    <iframe src="{{ spotifySrc }}" title="Spotify player: {{ playerTitle }}" height="352" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
  </div>
  {%- endif %}
  {%- if appleSrc %}
  {#- Built on demand by js/playlist-player.js: removing an embed is the
      only way to stop it, so the hidden one is never left playing. #}
  <div class="cc-player__embed" data-source="apple" data-embed-src="{{ appleSrc }}" data-embed-title="Apple Music player: {{ playerTitle }}"{% if spotifySrc %} hidden{% endif %}>
    {%- if not spotifySrc %}
    <iframe src="{{ appleSrc }}" title="Apple Music player: {{ playerTitle }}" height="450" allow="autoplay *; encrypted-media *; fullscreen *; clipboard-write" sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-storage-access-by-user-activation allow-top-navigation-by-user-activation" loading="lazy"></iframe>
    {%- endif %}
  </div>
  {%- endif %}
</div>
{%- endif %}
