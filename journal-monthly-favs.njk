---js
{
  // One Journal Post page per Monthly Favorites entry
  // (content/journal/monthly-favorites.json), at the same /journal/<slug>/
  // URL the Journal cards already link to. Renders through the same
  // layout as essays; the four song sections stand in for an essay body.
  pagination: {
    data: "journal.monthlyFavorites.entries",
    size: 1,
    alias: "fav"
  },
  permalink: function (data) {
    return "/journal/" + data.fav.slug + "/";
  },
  layout: "layouts/journal-post.njk",
  eleventyComputed: {
    title: function (data) { return data.fav.title; },
    category: "Monthly Favs",
    postDate: function (data) { return data.fav.date; },
    excerpt: function (data) { return data.fav.excerpt; },
    featured_image: function (data) { return data.fav.featured_image; },
    hero: function (data) { return data.fav.hero; },
    polaroid1: function (data) { return data.fav.polaroid1; },
    polaroid2: function (data) { return data.fav.polaroid2; }
  },
  sections: [
    { key: "new_releases", heading: "New Releases I Loved" },
    { key: "favorite_songs", heading: "Favorite Songs" },
    { key: "favorite_discoveries", heading: "Favorite Discoveries" },
    { key: "favorite_needledrops", heading: "Favorite Needledrops" }
  ]
}
---
{%- for section in sections %}
{%- set songs = fav[section.key] %}
{%- if songs and songs.length %}
<section class="jp-favs-section">
  <h2 class="jp-favs-section__heading">{{ section.heading }}</h2>
  <ul class="jp-favs-list">
    {%- for song in songs %}
    <li class="jp-favs-list__item">
      <span class="jp-favs-list__title">{{ song.title }}</span>
      <span class="jp-favs-list__artist">{{ song.artist }}</span>
      {%- if song.note %}
      <p class="jp-favs-list__note">{{ song.note }}</p>
      {%- endif %}
    </li>
    {%- endfor %}
  </ul>
</section>
{%- endif %}
{%- endfor %}
